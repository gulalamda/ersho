APP_PORT=8081

# ---- 数据库连接 ----
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=tlias
DB_USERNAME=ersho
DB_PASSWORD=ersho123

# ---- 仅备选方案 deploy/docker-compose.db.yml 用得到 ----
DB_ROOT_PASSWORD=root123

# JWT 签名密钥：填写至少 32 字节的随机字符串；留空则重启后需重新登录
JWT_SECRET=
